# SolarCS Command Center — environment variable NAMES only. Never commit real values.
# Copy to .env (git-ignored) and fill in. In hosting, set these as platform secrets.

# ── Server / API ──────────────────────────────────────────────────────────────
PORT=8787
# Data mode chosen SERVER-SIDE only: mock | test | production.
# Normal users cannot change this. Production with no connector → empty state.
DATA_MODE=mock

# ── Auth & sessions ─────────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. Use a long random value in every deployment.
COOKIE_SECRET=
# Session lifetime in milliseconds (default 8h).
SESSION_TTL_MS=28800000
# Password used to seed the local dev user store (hashed at startup, never stored
# in plaintext). Dev/staging only — production uses a real identity provider.
SEED_PASSWORD=

# ── Production data connectors (leave blank until fully secured) ─────────────────
# HubSpot private-app token — SERVER ONLY. Must never reach the browser bundle.
HUBSPOT_PRIVATE_APP_TOKEN=
# Enphase API credentials — SERVER ONLY.
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
# Database connection string — SERVER ONLY.
DATABASE_URL=

# ── Frontend (dev only) ──────────────────────────────────────────────────────────
# Where the Vite dev server proxies /api. Not used in production (same-origin).
VITE_API_PROXY=http://localhost:8787
