# SolarCS Command Center — environment variable NAMES only. Never commit real values.
# Copy to .env (git-ignored) and fill in. In hosting (Render), set these as env-group
# secrets. Production FAILS TO START if required values are missing or use dev defaults.

# ── Runtime mode ────────────────────────────────────────────────────────────────
# APP_MODE is the authority: development | test | production.
APP_MODE=development
NODE_ENV=development
# Data source: mock | test | production. Production REQUIRES production (no fallback).
DATA_MODE=mock
# User store: json | db. Production REQUIRES db; json is rejected in production.
USER_STORE=json
# Must be 1 in production (disables dev seed users). Non-prod may leave unset.
AUTH_DISABLE_SEED=

# ── Server / API ──────────────────────────────────────────────────────────────
PORT=8787
# Allowed frontend origin(s) for CORS/CSRF, comma-separated. REQUIRED in production.
FRONTEND_ORIGIN=http://localhost:5174
API_ORIGIN=http://localhost:8787
LOG_LEVEL=info
# Set to 1 so Express serves the built SPA (same-origin). Implied in production.
SERVE_SPA=
# Optional error monitoring — leave blank unless approved (do not commit a live DSN).
SENTRY_DSN=

# ── Auth & sessions ─────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production; must be a unique long random value.
COOKIE_SECRET=
# Separate secret for server-side session handling. REQUIRED in production.
SESSION_SECRET=
# Session lifetime in milliseconds (default 8h).
SESSION_TTL_MS=28800000
# Password used to seed the LOCAL dev user store only (hashed at startup, never stored
# in plaintext). Ignored in production (seed users disabled there).
SEED_PASSWORD=

# ── Database (Render-managed PostgreSQL) ─────────────────────────────────────────
# SERVER ONLY. Never commit a real value. Local dev example:
#   postgresql://solarcs:localdevonly@127.0.0.1:5432/solarcs_dev
DATABASE_URL=
# Shadow DB used by `prisma migrate dev` locally (not needed for migrate deploy).
SHADOW_DATABASE_URL=

# ── Transactional email (password reset) ────────────────────────────────────────
# Transport: test (non-delivering, dev/tests) | resend (real provider).
# Production REQUIRES a real provider — "test"/console are refused there.
EMAIL_TRANSPORT=test
# Resend API key (server only). Set in the host secret store, never committed.
RESEND_API_KEY=
# Verified sender, e.g. "SolarCS <no-reply@yourdomain.com>".
EMAIL_FROM=

# ── Future data connectors (leave blank — not connected this phase) ──────────────
HUBSPOT_PRIVATE_APP_TOKEN=
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=

# ── Frontend (dev only) ──────────────────────────────────────────────────────────
# Where the Vite dev server proxies /api. Not used in production (same-origin).
VITE_API_PROXY=http://localhost:8787
