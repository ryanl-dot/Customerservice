// SolarCS — production data model (Phase 2: users + sessions only).
// Uses the Rust-free Prisma client (query compiler) with the node-postgres driver
// adapter, so no query-engine binary is required at runtime. Migrations are applied
// with `prisma migrate deploy` (never `db push`) in staging/production.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (read from env), not in the schema.
}

enum Role {
  customer_service
  operations
  compliance
  management
  executive
  administrator
  developer
}

enum AccountStatus {
  active
  disabled
}

model User {
  id                String        @id @default(cuid())
  name              String
  // Stored already-normalized (trimmed + lowercased) by the app layer.
  email             String        @unique
  passwordHash      String
  role              Role
  accountStatus     AccountStatus @default(active)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastLoginAt       DateTime?
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime      @default(now())
  mfaEnabled        Boolean       @default(false)

  sessions Session[]

  @@map("users")
}

model Session {
  // High-entropy random id generated by the app; this is the opaque value the
  // signed cookie carries. Never contains user data.
  id           String    @id
  userId       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  // Hashed only — never raw IP / user-agent (data minimization).
  userAgentHash String?
  ipHash        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
