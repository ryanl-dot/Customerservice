// SolarCS — production data model (Phase 2: users + sessions only).
// Uses the Rust-free Prisma client (query compiler) with the node-postgres driver
// adapter, so no query-engine binary is required at runtime. Migrations are applied
// with `prisma migrate deploy` (never `db push`) in staging/production.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (read from env), not in the schema.
}

enum Role {
  customer_service
  operations
  compliance
  management
  executive
  administrator
  developer
}

enum AccountStatus {
  active
  disabled
}

model User {
  id                String        @id @default(cuid())
  name              String
  // Stored already-normalized (trimmed + lowercased) by the app layer.
  email             String        @unique
  passwordHash      String
  role              Role
  accountStatus     AccountStatus @default(active)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastLoginAt       DateTime?
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime      @default(now())
  mfaEnabled        Boolean       @default(false)
  // TOTP shared secret (base32). Present only once MFA is enrolled. Never returned
  // to the frontend. Nullable until enrollment.
  mfaSecret         String?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the single-use token. The raw token is emailed to the user and
  // never stored or logged. High-entropy random → plain hash is sufficient.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id            String   @id @default(cuid())
  eventType     String
  actorUserId   String?
  targetType    String?
  targetId      String?
  result        String   @default("success") // success | denied | error
  correlationId String?
  // Safe, non-sensitive metadata only. NEVER passwords/hashes/tokens/cookies/PII.
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

model Session {
  // High-entropy random id generated by the app; this is the opaque value the
  // signed cookie carries. Never contains user data.
  id           String    @id
  userId       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  // Hashed only — never raw IP / user-agent (data minimization).
  userAgentHash String?
  ipHash        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
